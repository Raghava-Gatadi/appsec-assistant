              "name": "SEC002",
              "shortDescription": {
                "text": "Private key material marker"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/321.html",
              "help": {
                "text": "Remove private keys from source control, rotate exposed keys and store replacements in managed secret storage. Confirm the marker belongs to actual private key material; public keys and test fixtures require different handling."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-321"
                ]
              }
            }
          ]
