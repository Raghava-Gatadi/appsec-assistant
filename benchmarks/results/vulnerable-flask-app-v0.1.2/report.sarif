{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AppSec Assistant",
          "version": "0.1.2",
          "rules": [
            {
              "id": "PY001",
              "name": "PY001",
              "shortDescription": {
                "text": "Dynamic SQL statement"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "help": {
                "text": "Use driver placeholders and pass values separately. Allowlist any dynamic table or column identifiers. Confirm this is a database API and determine whether any part of the statement is externally controlled."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89"
                ]
              }
            },
            {
              "id": "PY005",
              "name": "PY005",
              "shortDescription": {
                "text": "Unsafe YAML loader"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/502.html",
              "help": {
                "text": "Use yaml.safe_load or an explicitly selected SafeLoader/CSafeLoader. Check the installed PyYAML version and loader. Some modern versions reject a missing Loader instead of loading."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-502"
                ]
              }
            },
            {
              "id": "PY007",
              "name": "PY007",
              "shortDescription": {
                "text": "Weak hash algorithm"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/327.html",
              "help": {
                "text": "Use a modern hash for integrity; use a dedicated password KDF such as Argon2id for passwords. MD5/SHA-1 can be acceptable for non-security checksums. Identify the actual security use."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-327"
                ]
              }
            },
            {
              "id": "PY011",
              "name": "PY011",
              "shortDescription": {
                "text": "Dynamic template source"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1336.html",
              "help": {
                "text": "Keep template source fixed and pass untrusted content only as template data. Determine whether the value is template source or an ordinary template variable."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1336"
                ]
              }
            },
            {
              "id": "PY014",
              "name": "PY014",
              "shortDescription": {
                "text": "Input influences a filesystem path"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "help": {
                "text": "Resolve paths under a fixed allowed directory, enforce containment and consider symlink races; prefer opaque file IDs. Check the operation, allowed base directory, authorization and any validation before filesystem access."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-22"
                ]
              }
            },
            {
              "id": "PY016",
              "name": "PY016",
              "shortDescription": {
                "text": "JWT signature verification disabled"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/347.html",
              "help": {
                "text": "Verify the signature using a trusted key and fixed permitted algorithms; validate issuer, audience and lifetime. Confirm decoded claims are not trusted for authentication or authorization without verification."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-347"
                ]
              }
            },
            {
              "id": "SEC001",
              "name": "SEC001",
              "shortDescription": {
                "text": "Possible hardcoded credential"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "help": {
                "text": "Move credentials to a secret manager or runtime environment. Rotate any real exposed credential and review its use. The value is withheld. Confirm it is a live credential rather than an example, public identifier or test fixture."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            }
          ]
        }
      },
