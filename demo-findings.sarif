{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AppSec Assistant",
          "version": "0.1.0",
          "rules": [
            {
              "id": "CFG001",
              "name": "CFG001",
              "shortDescription": {
                "text": "Debug configuration enabled"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/489.html",
              "help": {
                "text": "Disable debug output and detailed error pages in production configuration. Check environment overrides and whether this file is used by a deployed application."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-489"
                ]
              }
            },
            {
              "id": "CFG002",
              "name": "CFG002",
              "shortDescription": {
                "text": "Secure cookie flag disabled"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/614.html",
              "help": {
                "text": "Enable Secure on authentication/session cookies and serve the application over HTTPS. Confirm the cookie's sensitivity and effective production settings."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-614"
                ]
              }
            },
            {
              "id": "JS002",
              "name": "JS002",
              "shortDescription": {
                "text": "Potential shell execution"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "help": {
                "text": "Use execFile/spawn with shell disabled, a fixed executable and validated arguments. Confirm this is Node child_process execution, then trace command input; similarly named APIs may be unrelated."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-78"
                ]
              }
            },
            {
              "id": "JS003",
              "name": "JS003",
              "shortDescription": {
                "text": "Raw HTML insertion"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "help": {
                "text": "Use textContent for text. Sanitize supported HTML with a maintained sanitizer and consider Trusted Types. Determine whether the inserted value is untrusted and whether a context-appropriate sanitizer is applied."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-79"
                ]
              }
            },
            {
              "id": "JS005",
              "name": "JS005",
              "shortDescription": {
                "text": "Potential SQL string construction"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "help": {
                "text": "Use parameterized queries with values passed separately; allowlist dynamic identifiers. This heuristic examines a local call window. Confirm the database API, query construction and input trust."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89"
                ]
              }
            },
            {
              "id": "PY001",
              "name": "PY001",
              "shortDescription": {
                "text": "Dynamic SQL statement"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "help": {
                "text": "Use driver placeholders and pass values separately. Allowlist any dynamic table or column identifiers. Confirm this is a database API and determine whether any part of the statement is externally controlled."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89"
                ]
              }
            },
            {
              "id": "PY002",
              "name": "PY002",
              "shortDescription": {
                "text": "Shell command construction"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "help": {
                "text": "Use an argument list with shell=False, a fixed executable and validated arguments. Avoid invoking a shell. Trace each value into the command; fixed commands and trusted maintenance scripts may be acceptable."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-78"
                ]
              }
            },
            {
              "id": "PY006",
              "name": "PY006",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/295.html",
              "help": {
                "text": "Enable certificate and hostname verification; configure a trusted CA bundle when needed. Confirm the setting is reachable in production and review the connection's trust requirements."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-295"
                ]
              }
            },
            {
              "id": "PY011",
              "name": "PY011",
              "shortDescription": {
                "text": "Dynamic template source"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1336.html",
              "help": {
                "text": "Keep template source fixed and pass untrusted content only as template data. Determine whether the value is template source or an ordinary template variable."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1336"
                ]
              }
            },
            {
              "id": "PY013",
              "name": "PY013",
              "shortDescription": {
                "text": "Input influences an outbound URL"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "help": {
                "text": "Allowlist destinations and schemes, validate resolved addresses and redirects, and enforce network egress restrictions. Confirm external control and check whether access to internal services or credentials is possible."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-918"
                ]
              }
            },
            {
              "id": "SEC001",
              "name": "SEC001",
              "shortDescription": {
                "text": "Possible hardcoded credential"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "help": {
                "text": "Move credentials to a secret manager or runtime environment. Rotate any real exposed credential and review its use. The value is withheld. Confirm it is a live credential rather than an example, public identifier or test fixture."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            }
          ]
        }
      },
